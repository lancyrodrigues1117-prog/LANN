# Leave these unset and the app keeps every quote in the browser.
# Set them (and run lib/supabase/schema.sql in the Supabase SQL editor)
# and the same app reads and writes quotes in Supabase instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prompt Desk generation. Without this the desk still builds prompts — only the
# Generate panel is switched off. Get a token at replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=
